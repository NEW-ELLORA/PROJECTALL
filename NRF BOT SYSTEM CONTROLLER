// ================= RECEIVER (FINAL FAST) ==================
// ESP32 + nRF24L01 + BTS7960 Motor Driver

#include <SPI.h>
#include <nRF24L01.h>
#include <RF24.h>

#define CE_PIN  13
#define CSN_PIN 25

RF24 radio(CE_PIN, CSN_PIN);
const byte address[6] = "NODE1";

enum Direction {
  DIR_STOP     = 0,
  DIR_FORWARD  = 1,
  DIR_BACKWARD = 2,
  DIR_LEFT     = 3,
  DIR_RIGHT    = 4
};

Direction dir;

// BTS7960 pins
const int RPWM = 32;
const int LPWM = 33;
const int R_EN = 22;
const int L_EN = 23;

void motorStop() {
  digitalWrite(RPWM, LOW);
  digitalWrite(LPWM, LOW);
}

void motorClockwise() {
  digitalWrite(RPWM, HIGH);
  digitalWrite(LPWM, LOW);
}

void motorAntiClockwise() {
  digitalWrite(RPWM, LOW);
  digitalWrite(LPWM, HIGH);
}

void setup() {
  Serial.begin(115200);

  pinMode(RPWM, OUTPUT);
  pinMode(LPWM, OUTPUT);
  pinMode(R_EN, OUTPUT);
  pinMode(L_EN, OUTPUT);

  digitalWrite(R_EN, HIGH);
  digitalWrite(L_EN, HIGH);
  motorStop();

  SPI.begin(14, 26, 27, CSN_PIN);
  radio.begin();
  radio.setAutoAck(false);
  radio.setPALevel(RF24_PA_HIGH);
  radio.setChannel(108);
  radio.setDataRate(RF24_1MBPS);
  radio.openReadingPipe(0, address);
  radio.startListening();

  Serial.println("Receiver READY");
}

void loop() {
  if (radio.available()) {
    radio.read(&dir, sizeof(dir));

    switch (dir) {
      case DIR_FORWARD:
        Serial.println("FORWARD → Anti-Clockwise");
        motorAntiClockwise();
        break;

      case DIR_LEFT:
        Serial.println("LEFT → Anti-Clockwise");
        motorAntiClockwise();
        break;

      case DIR_BACKWARD:
        Serial.println("BACKWARD → Clockwise");
        motorClockwise();
        break;

      case DIR_RIGHT:
        Serial.println("RIGHT → Clockwise");
        motorClockwise();
        break;

      default:
        Serial.println("STOP");
        motorStop();
        break;
    }
  }
}


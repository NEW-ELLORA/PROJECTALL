// Joystick direction + value display with DIRECTION LOCK
// VRX → GPIO 34  (Left / Right)
// VRY → GPIO 35  (Up / Down)

const int VRX_PIN = 34;
const int VRY_PIN = 35;

int CENTER_X = 2048;
int CENTER_Y = 2048;

const int DEADZONE   = 300;  // center area
const int ACTIVATE   = 400;  // minimum movement to accept a direction

enum Direction {
  DIR_STOP,
  DIR_FORWARD,
  DIR_BACKWARD,
  DIR_LEFT,
  DIR_RIGHT
};

Direction currentDir = DIR_STOP;

void calibrateCenter() {
  Serial.println("Calibrating center... DON'T TOUCH the joystick.");
  delay(2000);

  long sumX = 0, sumY = 0;
  const int samples = 100;

  for (int i = 0; i < samples; i++) {
    sumX += analogRead(VRX_PIN);
    sumY += analogRead(VRY_PIN);
    delay(5);
  }

  CENTER_X = sumX / samples;
  CENTER_Y = sumY / samples;

  Serial.print("CENTER_X = ");
  Serial.print(CENTER_X);
  Serial.print("   CENTER_Y = ");
  Serial.println(CENTER_Y);
  Serial.println("Move joystick now...");
}

const char* dirToText(Direction d) {
  switch (d) {
    case DIR_FORWARD:  return "FORWARD";
    case DIR_BACKWARD: return "BACKWARD";
    case DIR_LEFT:     return "LEFT";
    case DIR_RIGHT:    return "RIGHT";
    default:           return "STOP";
  }
}

void setup() {
  Serial.begin(115200);
  delay(200);
  calibrateCenter();
}

void loop() {
  int x = analogRead(VRX_PIN);
  int y = analogRead(VRY_PIN);

  int dx = x - CENTER_X;
  int dy = y - CENTER_Y;

  // Print raw values first
  Serial.print("VRX = ");
  Serial.print(x);
  Serial.print("  VRY = ");
  Serial.print(y);
  Serial.print("  dx = ");
  Serial.print(dx);
  Serial.print("  dy = ");
  Serial.print(dy);
  Serial.print("  ->  ");

  // 1️⃣ If joystick is back near center → unlock and STOP
  if (abs(dx) < DEADZONE && abs(dy) < DEADZONE) {
    currentDir = DIR_STOP;
    Serial.println("STOP");
    delay(100);
    return;
  }

  // 2️⃣ If we already have a direction, KEEP IT (no jumping)
  if (currentDir != DIR_STOP) {
    Serial.println(dirToText(currentDir));
    delay(100);
    return;
  }

  // 3️⃣ No direction yet (just left center) → decide ONE direction now

  // Ignore tiny movements
  if (abs(dx) < ACTIVATE && abs(dy) < ACTIVATE) {
    Serial.println("STOP");
    delay(100);
    return;
  }

  // Choose dominant axis *once*
  if (abs(dy) >= abs(dx)) {
    // UP / DOWN dominates
    if (dy < 0) currentDir = DIR_FORWARD;
    else        currentDir = DIR_BACKWARD;
  } else {
    // LEFT / RIGHT dominates
    if (dx < 0) currentDir = DIR_LEFT;
    else        currentDir = DIR_RIGHT;
  }

  Serial.println(dirToText(currentDir));
  delay(100);
}


// Receiver: ESP32 + nRF24L01+PA+LNA (adapter board) + BTS7960 motor driver
// Pins: CE=13, CSN=25, SCK=14, MISO=26, MOSI=27

#include <SPI.h>
#include <nRF24L01.h>
#include <RF24.h>

#define CE_PIN   13
#define CSN_PIN  25

// SPI pins: SCK, MISO, MOSI, SS(CSN)
const int SPI_SCK  = 14;
const int SPI_MISO = 26;
const int SPI_MOSI = 27;
const int SPI_SS   = CSN_PIN;

RF24 radio(CE_PIN, CSN_PIN);
const byte rxAddress[6] = "NODE1";

// ===== BTS7960 pins (adjust if your wiring is different) =====
const int RPWM_PIN = 32;  // RPWM
const int LPWM_PIN = 33;  // LPWM
const int R_EN_PIN = 22;  // R_EN
const int L_EN_PIN = 23;  // L_EN

uint8_t incomingAngle = 255;

void motorStop() {
  digitalWrite(RPWM_PIN, LOW);
  digitalWrite(LPWM_PIN, LOW);
}

void motorForward() {
  digitalWrite(RPWM_PIN, HIGH);
  digitalWrite(LPWM_PIN, LOW);
}

void motorReverse() {
  digitalWrite(RPWM_PIN, LOW);
  digitalWrite(LPWM_PIN, HIGH);
}

void setup() {
  Serial.begin(115200);
  delay(200);

  // Motor driver pins
  pinMode(RPWM_PIN, OUTPUT);
  pinMode(LPWM_PIN, OUTPUT);
  pinMode(R_EN_PIN, OUTPUT);
  pinMode(L_EN_PIN, OUTPUT);

  // Enable BTS7960 outputs
  digitalWrite(R_EN_PIN, HIGH);
  digitalWrite(L_EN_PIN, HIGH);

  motorStop();

  // Initialize SPI on custom pins BEFORE radio.begin()
  SPI.begin(SPI_SCK, SPI_MISO, SPI_MOSI, SPI_SS);

  radio.begin();
  radio.setPALevel(RF24_PA_HIGH); // PA+LNA
  radio.setChannel(108);
  radio.setDataRate(RF24_1MBPS);
  radio.openReadingPipe(0, rxAddress);
  radio.startListening();

  Serial.println("Receiver ready");
}

void loop() {
  if (radio.available()) {
    radio.read(&incomingAngle, sizeof(incomingAngle));
    Serial.print("Received angle: ");
    Serial.println(incomingAngle);

    // Joystick UP (90)  -> motor forward
    // Joystick DOWN (45)-> motor reverse
    // Anything else     -> motor stop
    if (incomingAngle == 90) {
      motorForward();
    } else if (incomingAngle == 45) {
      motorReverse();
    } else {
      motorStop();
    }
  }

  delay(20);
}


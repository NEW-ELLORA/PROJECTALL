// =============== TRANSMITTER (FAST) ===============
// ESP32 + nRF24L01 + PS2 Joystick
// VRX -> GPIO 34  (Left/Right)
// VRY -> GPIO 35  (Up/Down)

#include <SPI.h>
#include <nRF24L01.h>
#include <RF24.h>

#define CE_PIN   13
#define CSN_PIN  25

RF24 radio(CE_PIN, CSN_PIN);
const byte address[6] = "NODE1";

const int VRX_PIN = 34;
const int VRY_PIN = 35;

int CENTER_X = 2048;
int CENTER_Y = 2048;

const int DEADZONE       = 300;   // center
const int ACT_THRESHOLD  = 400;   // how far to move before we lock a direction

enum Direction {
  DIR_STOP     = 0,
  DIR_FORWARD  = 1,
  DIR_BACKWARD = 2,
  DIR_LEFT     = 3,
  DIR_RIGHT    = 4
};

Direction currentDir = DIR_STOP;

// ---------- FAST CALIBRATION ----------
void calibrateCenter() {
  Serial.println("Quick calibrating joystick... DON'T TOUCH.");
  delay(300);  // short settle time

  long sumX = 0, sumY = 0;
  const int samples = 30;   // fewer samples for speed

  for (int i = 0; i < samples; i++) {
    sumX += analogRead(VRX_PIN);
    sumY += analogRead(VRY_PIN);
    delay(5);  // 30 * 5ms = 150ms
  }

  CENTER_X = sumX / samples;
  CENTER_Y = sumY / samples;

  Serial.print("CENTER_X = "); Serial.print(CENTER_X);
  Serial.print("  CENTER_Y = "); Serial.println(CENTER_Y);
  Serial.println("Ready!");
}

void setup() {
  Serial.begin(115200);
  calibrateCenter();

  SPI.begin(14, 26, 27, CSN_PIN);
  radio.begin();
  radio.setAutoAck(false);
  radio.setPALevel(RF24_PA_HIGH);
  radio.setChannel(108);
  radio.setDataRate(RF24_1MBPS);
  radio.openWritingPipe(address);
  radio.stopListening();

  Serial.println("Transmitter READY");
}

void loop() {
  int x = analogRead(VRX_PIN);
  int y = analogRead(VRY_PIN);

  int dx = x - CENTER_X;
  int dy = y - CENTER_Y;

  // 1) Joystick near center → unlock & STOP
  if (abs(dx) < DEADZONE && abs(dy) < DEADZONE) {
    currentDir = DIR_STOP;
  }
  // 2) No direction currently locked → choose one ONCE
  else if (currentDir == DIR_STOP) {
    if (abs(dx) >= ACT_THRESHOLD || abs(dy) >= ACT_THRESHOLD) {
      if (abs(dy) >= abs(dx)) {
        currentDir = (dy < 0 ? DIR_FORWARD : DIR_BACKWARD);
      } else {
        currentDir = (dx < 0 ? DIR_LEFT : DIR_RIGHT);
      }
    }
  }

  // 3) Send direction every loop (simple & robust)
  radio.write(&currentDir, sizeof(currentDir));

  // Debug
  Serial.print("Direction -> ");
  switch (currentDir) {
    case DIR_FORWARD:  Serial.println("FORWARD"); break;
    case DIR_BACKWARD: Serial.println("BACKWARD"); break;
    case DIR_LEFT:     Serial.println("LEFT"); break;
    case DIR_RIGHT:    Serial.println("RIGHT"); break;
    default:           Serial.println("STOP"); break;
  }

  delay(40);  // ~25 updates per second, feels snappy
}


#include <WiFi.h>
#include <esp_now.h>

// ================= DATA STRUCT =================
typedef struct struct_message {
  int motorA;   // -1000 to +1000
  int motorB;   // -1000 to +1000
  int button;
} struct_message;

struct_message rxData;

// ================= MOTOR PINS =================
// Motor A
const uint8_t A_RPWM = 32;
const uint8_t A_LPWM = 33;
const uint8_t A_R_EN = 26;
const uint8_t A_L_EN = 25;

// Motor B
const uint8_t B_RPWM = 12;
const uint8_t B_LPWM = 13;
const uint8_t B_R_EN = 14;
const uint8_t B_L_EN = 27;

// ================= MOTOR DRIVER =================
void driveMotor(uint8_t rpwm, uint8_t lpwm,
                uint8_t ren,  uint8_t len,
                int speed) {

  speed = constrain(speed, -1000, 1000);
  int pwm = map(abs(speed), 0, 1000, 0, 255);

  digitalWrite(ren, HIGH);
  digitalWrite(len, HIGH);

  if (speed > 0) {
    analogWrite(rpwm, pwm);
    analogWrite(lpwm, 0);
  }
  else if (speed < 0) {
    analogWrite(rpwm, 0);
    analogWrite(lpwm, pwm);
  }
  else {
    analogWrite(rpwm, 0);
    analogWrite(lpwm, 0);
  }
}

// ================= ESP-NOW RX CALLBACK =================
void onDataRecv(const esp_now_recv_info *info,
                const uint8_t *incomingData,
                int len) {

  if (len != sizeof(struct_message)) return;

  memcpy(&rxData, incomingData, sizeof(rxData));

  driveMotor(A_RPWM, A_LPWM, A_R_EN, A_L_EN, rxData.motorA);
  driveMotor(B_RPWM, B_LPWM, B_R_EN, B_L_EN, rxData.motorB);
}

void setup() {
  Serial.begin(115200);

  pinMode(A_RPWM, OUTPUT);
  pinMode(A_LPWM, OUTPUT);
  pinMode(A_R_EN, OUTPUT);
  pinMode(A_L_EN, OUTPUT);

  pinMode(B_RPWM, OUTPUT);
  pinMode(B_LPWM, OUTPUT);
  pinMode(B_R_EN, OUTPUT);
  pinMode(B_L_EN, OUTPUT);

  WiFi.mode(WIFI_STA);

  if (esp_now_init() != ESP_OK) {
    Serial.println("ESP-NOW init failed");
    return;
  }

  esp_now_register_recv_cb(onDataRecv);

  Serial.println("ESP-NOW Receiver Ready (New Pins)");
}

void loop() {
  // handled by ESP-NOW callback
}


#include <WiFi.h>
#include <esp_now.h>
#include <esp_wifi.h>

// ================= RECEIVER MAC =================
uint8_t receiverMac[] = {0x98, 0xF4, 0xAB, 0x09, 0x61, 0xB4};

// ================= BUZZER =================
#define BUZZER_PIN 4

// ================= PS2 JOYSTICK =================
#define VRX_PIN 34
#define VRY_PIN 35
#define BTN_PIN 32

#define ADC_MAX 4095
#define DEADZONE 350
#define OUT_MAX 1000

// -------- PERFECT SYMMETRY CALIB --------
int centerX, centerY;
int maxUp, maxDown, maxLeft, maxRight;

// -------- BUZZER STATE --------
bool espNowConnected = false;

// ================= DATA STRUCT =================
typedef struct {
  int motorA;
  int motorB;
  int button;
} struct_message;

struct_message tx;

// ================= BUZZER HELPERS =================
void beep(int ms)
{
  digitalWrite(BUZZER_PIN, HIGH);
  delay(ms);
  digitalWrite(BUZZER_PIN, LOW);
  delay(100);
}

void doubleBeep()
{
  beep(120);
  beep(120);
}

// ================= ESP-NOW CALLBACK =================
void onSent(const wifi_tx_info_t *info, esp_now_send_status_t status)
{
  // First successful transmission = CONNECTED
  if (!espNowConnected && status == ESP_NOW_SEND_SUCCESS) {
    espNowConnected = true;
    digitalWrite(BUZZER_PIN, HIGH);
    delay(2000);                // 2 seconds continuous beep
    digitalWrite(BUZZER_PIN, LOW);
  }
}

void setup()
{
  Serial.begin(115200);

  pinMode(BTN_PIN, INPUT_PULLUP);
  pinMode(BUZZER_PIN, OUTPUT);
  digitalWrite(BUZZER_PIN, LOW);

  analogReadResolution(12);
  delay(500);

  // -------- POWER ON BEEP (TWICE) --------
  doubleBeep();

  // -------- CENTER CALIBRATION --------
  long sx = 0, sy = 0;
  for (int i = 0; i < 200; i++) {
    sx += analogRead(VRX_PIN);
    sy += analogRead(VRY_PIN);
    delay(5);
  }
  centerX = sx / 200;
  centerY = sy / 200;

  // Init limits
  maxUp = maxDown = maxLeft = maxRight = 1;

  Serial.println("Move joystick fully in all directions...");

  // -------- ESP-NOW --------
  WiFi.mode(WIFI_STA);
  esp_wifi_set_channel(1, WIFI_SECOND_CHAN_NONE);

  if (esp_now_init() != ESP_OK) {
    Serial.println("ESP-NOW init failed");
    return;
  }

  esp_now_register_send_cb(onSent);

  esp_now_peer_info_t peer = {};
  memcpy(peer.peer_addr, receiverMac, 6);
  peer.channel = 1;
  peer.encrypt = false;
  esp_now_add_peer(&peer);
}

void loop()
{
  int rawX = analogRead(VRX_PIN);
  int rawY = analogRead(VRY_PIN);

  // -------- AUTO-LEARN MAX LIMITS --------
  maxUp    = max(maxUp, centerY - rawY);
  maxDown  = max(maxDown, rawY - centerY);
  maxLeft  = max(maxLeft, centerX - rawX);
  maxRight = max(maxRight, rawX - centerX);

  int x = rawX - centerX;
  int y = rawY - centerY;

  int up = 0, down = 0, left = 0, right = 0;

  int absX = abs(x);
  int absY = abs(y);

  // -------- DOMINANT AXIS LOCK --------
  if (absY > absX && absY > DEADZONE) {
    if (y < 0)
      up = map(absY, DEADZONE, maxUp, 0, OUT_MAX);
    else
      down = map(absY, DEADZONE, maxDown, 0, OUT_MAX);
  }
  else if (absX > DEADZONE) {
    if (x > 0)
      right = map(absX, DEADZONE, maxRight, 0, OUT_MAX);
    else
      left = map(absX, DEADZONE, maxLeft, 0, OUT_MAX);
  }

  // -------- SAFETY CLAMP --------
  up    = constrain(up, 0, OUT_MAX);
  down  = constrain(down, 0, OUT_MAX);
  left  = constrain(left, 0, OUT_MAX);
  right = constrain(right, 0, OUT_MAX);

  // ================= RC MIXING =================
  int throttle = up - down;
  int steering = right - left;

  tx.motorA = constrain(throttle + steering, -OUT_MAX, OUT_MAX);
  tx.motorB = constrain(throttle - steering, -OUT_MAX, OUT_MAX);
  tx.button = (digitalRead(BTN_PIN) == LOW) ? 1 : 0;

  esp_now_send(receiverMac, (uint8_t *)&tx, sizeof(tx));

  // -------- DEBUG --------
  Serial.print("UP:");
  Serial.print(up);
  Serial.print(" DOWN:");
  Serial.print(down);
  Serial.print(" LEFT:");
  Serial.print(left);
  Serial.print(" RIGHT:");
  Serial.print(right);
  Serial.print(" | A:");
  Serial.print(tx.motorA);
  Serial.print(" B:");
  Serial.print(tx.motorB);
  Serial.print(" BTN:");
  Serial.println(tx.button);

  delay(60);
}


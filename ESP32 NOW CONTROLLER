// =====================================================
// ESP32 + PS2 JOYSTICK + ESP-NOW TRANSMITTER (STABLE)
// CALIBRATION + RC MIXING + BUZZER (NON-BLOCKING)
// =====================================================

#include <WiFi.h>
#include <esp_now.h>

// ================= RECEIVER MAC =================
uint8_t receiverMac[] = {0x98, 0xF4, 0xAB, 0x09, 0x61, 0xB4};

// ================= BUZZER =================
#define BUZZER_PIN 4

// ================= JOYSTICK PINS =================
#define VRX_PIN 34
#define VRY_PIN 35
#define BTN_PIN 32

#define ADC_MAX 4095
#define OUT_MAX 1000

// ================= CALIBRATION ZONES =================
#define DEADZONE        400
#define RECENTER_ZONE   250
#define SNAP_ZERO       80
#define FILTER_ALPHA    0.2

float fx = 0, fy = 0;
int centerX = 0, centerY = 0;

// ================= DATA STRUCT =================
typedef struct struct_message {
  int motorA;
  int motorB;
  int button;
} struct_message;

struct_message txData;

// ================= LINK / BUZZER STATE =================
bool linkConfirmed = false;
bool linkBeepActive = false;
unsigned long linkBeepStart = 0;

// ================= STABLE ADC =================
int readStableADC(int pin) {
  long sum = 0;
  for (int i = 0; i < 12; i++) {
    sum += analogRead(pin);
    delayMicroseconds(150);
  }
  return sum / 12;
}

// ================= BUZZER HELPERS =================
void beep(uint16_t ms) {
  digitalWrite(BUZZER_PIN, HIGH);
  delay(ms);
  digitalWrite(BUZZER_PIN, LOW);
}

// ================= ESP-NOW SEND CALLBACK =================
void onDataSent(const wifi_tx_info_t *info,
                esp_now_send_status_t status) {

  if (status == ESP_NOW_SEND_SUCCESS && !linkConfirmed) {
    linkConfirmed = true;
    linkBeepActive = true;
    linkBeepStart = millis();
    digitalWrite(BUZZER_PIN, HIGH);   // start beep
  }
}

// ================= SETUP =================
void setup() {
  Serial.begin(115200);

  pinMode(BTN_PIN, INPUT_PULLUP);
  pinMode(BUZZER_PIN, OUTPUT);
  digitalWrite(BUZZER_PIN, LOW);

  analogReadResolution(12);

  // -------- POWER ON BEEP --------
  beep(150); delay(150); beep(150);

  // -------- AUTO CALIBRATION (UNCHANGED) --------
  long sx = 0, sy = 0;
  for (int i = 0; i < 200; i++) {
    sx += analogRead(VRX_PIN);
    sy += analogRead(VRY_PIN);
    delay(5);
  }

  centerX = sx / 200;
  centerY = sy / 200;
  fx = centerX;
  fy = centerY;

  // -------- ESP-NOW INIT --------
  WiFi.mode(WIFI_STA);
  WiFi.disconnect(true);

  if (esp_now_init() != ESP_OK) {
    Serial.println("ESP-NOW init FAILED");
    while (1);
  }

  esp_now_register_send_cb(onDataSent);

  esp_now_peer_info_t peerInfo = {};
  memcpy(peerInfo.peer_addr, receiverMac, 6);
  peerInfo.channel = 0;      // MUST match receiver
  peerInfo.encrypt = false;

  if (esp_now_add_peer(&peerInfo) != ESP_OK) {
    Serial.println("Peer add FAILED");
    while (1);
  }

  Serial.println("ESP-NOW Transmitter READY");
}

// ================= LOOP =================
void loop() {
  // -------- HANDLE LINK BEEP (NON-BLOCKING) --------
  if (linkBeepActive && millis() - linkBeepStart >= 2000) {
    digitalWrite(BUZZER_PIN, LOW);
    linkBeepActive = false;
  }

  int rawX = readStableADC(VRX_PIN);
  int rawY = readStableADC(VRY_PIN);

  fx += FILTER_ALPHA * (rawX - fx);
  fy += FILTER_ALPHA * (rawY - fy);

  int dx = (int)fx - centerX;
  int dy = (int)fy - centerY;

  if (abs(dx) < RECENTER_ZONE && abs(dy) < RECENTER_ZONE) {
    centerX = (centerX * 99 + fx) / 100;
    centerY = (centerY * 99 + fy) / 100;
  }

  int up = 0, down = 0, left = 0, right = 0;

  if (abs(dy) > DEADZONE) {
    int v = map(abs(dy), DEADZONE, ADC_MAX / 2, 0, OUT_MAX);
    if (dy < 0) up = v; else down = v;
  }

  if (abs(dx) > DEADZONE) {
    int v = map(abs(dx), DEADZONE, ADC_MAX / 2, 0, OUT_MAX);
    if (dx < 0) left = v; else right = v;
  }

  if (up < SNAP_ZERO) up = 0;
  if (down < SNAP_ZERO) down = 0;
  if (left < SNAP_ZERO) left = 0;
  if (right < SNAP_ZERO) right = 0;

  // -------- RC DIAGONAL MIXING --------
  int throttle = up - down;
  int steering = right - left;

  txData.motorA = constrain(throttle + steering, -OUT_MAX, OUT_MAX);
  txData.motorB = constrain(throttle - steering, -OUT_MAX, OUT_MAX);
  txData.button = (digitalRead(BTN_PIN) == LOW);

  esp_now_send(receiverMac, (uint8_t *)&txData, sizeof(txData));

  delay(60);
}
